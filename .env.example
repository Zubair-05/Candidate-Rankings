# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text         # text (coloured, dev) | json (structured, production)

# ── LLM provider ─────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | groq
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.1

# ── Layer 3 pipeline knobs ────────────────────────────────────────────────────
LAYER3_CANDIDATE_POOL=50      # how many Layer 2 candidates enter the LLM judge
LAYER3_FINAL_TOP_K=20         # how many come out of the LLM judge
LAYER3_MAX_CONCURRENCY=5      # parallel LLM calls cap

# ── API keys (set whichever provider you use) ─────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GROQ_API_KEY=your-groq-key-here

# ── Database / Cache (future) ─────────────────────────────────────────────────
POSTGRES_DSN=postgresql://aiops:aiops@localhost:5432/candidate_ranking
REDIS_URL=redis://localhost:6379/0
